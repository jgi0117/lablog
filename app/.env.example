# 저장소 구현 선택: local(기본, 이 브라우저에 저장) | supabase(서버에 저장, 로그인 필요)
VITE_DATA_BACKEND=local

# supabase를 쓸 때 채운다. 이 파일을 .env.local로 복사해서 쓰면 git에 올라가지 않는다.
# 공개용(anon/publishable) 키만 넣는다. service_role 키(sb_secret_...)는 절대 넣지 않는다(넣으면 앱이 시작하지 않는다).
# 순서: docs/phase9/02-설정-가이드.md
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 가입 버튼을 보이려면 true (기본은 숨김. 개인용이라 서버에서도 가입을 끈다)
VITE_ALLOW_SIGNUP=
